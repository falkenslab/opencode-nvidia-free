 """Convierte textos en slugs para URLs."""
 
 
+import unicodedata
+import re
+
+
 def slugify(text: str, max_length: int = 50) -> str:
     """Devuelve un slug en minúsculas, sin acentos, con palabras separadas por guiones.
 
@@ -11,4 +15,27 @@ def slugify(text: str, max_length: int = 50) -> str:
       Si la primera palabra ya supera `max_length`, se corta a `max_length` caracteres.
     - Si no queda nada, devuelve una cadena vacía.
     """
-    raise NotImplementedError
+    text = unicodedata.normalize('NFKD', text).encode('ascii', 'ignore').decode('ascii')
+    text = text.lower()
+    text = re.sub(r'[^a-z0-9]+', '-', text)
+    text = text.strip('-')
+
+    if max_length > 0 and len(text) > max_length:
+        parts = text.split('-')
+        result = []
+        current_length = 0
+        for part in parts:
+            if current_length == 0:
+                if len(part) > max_length:
+                    result.append(part[:max_length])
+                    break
+                result.append(part)
+                current_length = len(part)
+            else:
+                if current_length + 1 + len(part) > max_length:
+                    break
+                result.append(part)
+                current_length += 1 + len(part)
+        text = '-'.join(result)
+
+    return text
